Algoritmo salarioempleado
	//desarrolle un algoritmo que permita saber el salario de un empleado
	//aqui defini las variables
	definir minimo como real
	definir dias como entero
	//aqui pedi los dias trabajados
	escribir "ingrese los dias que trabajo este mes"
	leer dias
	//aqui hize el calculo
	minimo<- (1750905* dias) / 30
	//aqui doy el resultado
	escribir "El salario de usted es de:" minimo
FinAlgoritmo
