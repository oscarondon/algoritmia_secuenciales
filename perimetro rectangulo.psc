Algoritmo perimetrorectangulo
	//desarrolle un algoritmo que permita calcular el perimetro de un rectangulo
	//aqui defini las variables
	definir base,altura,perimetro Como Real
	//aqui pedi la base
	escribir "ingrese la base del rectangulo: "
	leer base
	//aqui pedi la altura
	escribir "ingrese la altura del rectangulo:"
	leer altura
	//aqui hize el calculo
	perimetro<- 2*(base+altura)
	//aqui doy el resultado
	escribir  "el perimetro del rectangulo es de: " perimetro
FinAlgoritmo
