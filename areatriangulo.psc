Algoritmo areatriangulo
	//desarrolle un algoritmo que permita calcular el area de un triangulo
	//aqui defini las variables
	definir base,altura,area como real
	//aqui pedi la base
	escribir "ingrese la base de triangulo"
	leer base
	escribir "ingrese la altura de triangulo"
	leer altura
	//aqui hize el calculo
	area<- (base*altura)/2
	//aqui doy el resultado
	escribir  "el area del triangulo es de: " area
FinAlgoritmo
