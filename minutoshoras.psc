Algoritmo minutoshoras
	//desarrolle un algoritmo que permita calcular minutos a horas
	//aqui defini las variables
	definir minutos como entero
	definir horas Como Real
	//aqui pedi los minutos
	escribir "ingrese los minutos: "
	leer minutos
	//aqui hize el calculo
	horas<- minutos / 60
	//aqui doy el resultado
	escribir  minutos," minutos son: " horas " horas"
FinAlgoritmo
