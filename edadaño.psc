Algoritmo edadaño
	//desarrolle un algoritmo que permita calcular la edad apartir de su nacimiento
	//aqui defini las variables
	definir edad,año como entero
	//aqui pedi el año de nacimiento
	escribir "ingrese el año de su nacimiento"
	leer año
	//aqui hize el calculo
	edad<- 2026-año
	//aqui doy el resultado
	escribir  "usted tiene: ",edad " años"
FinAlgoritmo
