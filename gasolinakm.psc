Algoritmo gasolinakm
	//desarrolle un algoritmo que permita calcular el consumo de gasolina por km
	//aqui defini las variables
	definir gasolina,km,recorrido Como real
	//aqui pedi la gasonlina en litros
	escribir "ingrese la cantidad de gasolina en litros: "
	leer gasolina
	escribir "ingrese la cantidad de km recorridos: "
	leer km
	//aqui hize el calculo
	recorrido <- gasolina/km
	//aqui doy el resultado
	escribir  "el consumo de gasolina fue de: " recorrido
FinAlgoritmo
