Algoritmo celsiusfahrenheit
	//desarrolle un algoritmo que permita calcular celsius a fahrenheit
	//aqui defini las variables
	definir celsius,fahrenheit como real
	//aqui pedi los celsius
	escribir "ingrese los celsius"
	leer celsius
	//aqui hize el calculo
	fahrenheit<- (celsius * 1.8) +32
	//aqui doy el resultado
	escribir  celsius," celsius son: " fahrenheit " fahrenheit"
FinAlgoritmo
