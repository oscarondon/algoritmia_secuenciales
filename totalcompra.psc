Algoritmo totalcompra
	//desarrolle un algoritmo que permita calcular el total de una compra
	//aqui defini las variables
	definir cantidad como entero
	definir precio,resultado como real
	//aqui pedi el precio del producto
	escribir "ingrese el precio del producto: "
	leer precio
	//aqui pedi la cantidad del producto
	escribir "ingrese la cantidad del producto: "
	leer cantidad
	//aqui hize el calculo
	resultado<- precio*cantidad
	//aqui doy el resultado
	escribir  "el total de su compra fue de: " resultado
FinAlgoritmo
