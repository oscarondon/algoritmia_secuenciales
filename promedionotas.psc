Algoritmo promedio3notas
	//desarrolle un algoritmo que permita calcular el promedio de 3 notas
	//aqui defini las variables
	definir nota1,nota2,nota3,resultado como real
	//aqui pedi las notas
	escribir "ingrese su primer nota"
	leer nota1
	escribir "ingrese su segunda nota"
	leer nota2
	escribir "ingrese su tercer nota"
	leer nota3
	//aqui hize el calculo
	resultado<- (nota1+nota2+nota3)/3
	//aqui doy el resultado
	escribir "su promedio es de: " resultado
FinAlgoritmo
